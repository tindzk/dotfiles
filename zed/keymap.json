[
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "H": "pane::GoBack",
      "L": "pane::GoForward",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-w": "pane::CloseActiveItem",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-c": "editor::Copy",
      "cmd-insert": "editor::Copy",
      "cmd-shift-z": "editor::Redo",
      "cmd-v": "editor::Paste",
      "cmd-x": "editor::Cut",
      "cmd-y": "editor::Redo",
      "cmd-z": "editor::Undo",
      "cmd-r": "editor::Rename",
      "ctrl-u": ["workspace::SendKeystrokes", "1 5 k z z"],
      "ctrl-d": ["workspace::SendKeystrokes", "1 5 j z z"],
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-c": "terminal::Copy",
      "cmd-v": "terminal::Paste",
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "g r": "editor::FindAllReferences",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-enter": "editor::ToggleCodeActions",
      "ctrl-p": "file_finder::Toggle",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-s": "workspace::Save",
      "cmd-t": "task::Rerun",
      "cmd-shift-t": "task::Spawn",
      "ctrl-t": "project_symbols::Toggle",
    },
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": {
      "tab": "editor::AcceptEditPrediction",
      "alt-l": null,
    },
  },
  {
    "context": "Editor && (edit_prediction && (showing_completions || in_leading_whitespace))",
    "bindings": {
      "super-tab": "editor::AcceptEditPrediction",
      "alt-l": null,
    },
  },
  {
    // The JetBrains base keymap binds cmd-- to editor::Fold and cmd-+ to
    // editor::UnfoldLines in the Editor context, which shadows the font size
    // bindings. Rebind them here so they also work while an editor is focused.
    // These keys change only the buffer font size.
    "context": "Editor",
    "bindings": {
      "cmd--": ["zed::DecreaseBufferFontSize", { "persist": false }],
      "cmd-=": ["zed::IncreaseBufferFontSize", { "persist": false }],
      "cmd-+": ["zed::IncreaseBufferFontSize", { "persist": false }],
    },
  },
]
